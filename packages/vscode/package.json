{
  "name": "hero-synergy",
  "displayName": "Hero Synergy",
  "version": "0.2.0",
  "private": true,
  "description": "See your wayfinder frontier and start each ticket as a named Claude Code session, with live status.",
  "categories": [
    "AI"
  ],
  "keywords": [
    "agent",
    "agent skills",
    "ai",
    "claude",
    "claude code",
    "github issues",
    "issue tracker",
    "matt pocock",
    "mattpocock",
    "sessions",
    "skills",
    "terminal",
    "wayfinder",
    "worktree"
  ],
  "homepage": "https://github.com/dbarjs/hero-synergy#readme",
  "bugs": {
    "url": "https://github.com/dbarjs/hero-synergy/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dbarjs/hero-synergy.git",
    "directory": "packages/vscode"
  },
  "qna": false,
  "publisher": "dbarjs",
  "files": [
    "dist",
    "claude-plugin",
    "media",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "main": "./dist/extension.cjs",
  "scripts": {
    "build": "vp pack && vp build",
    "typecheck": "vue-tsc --noEmit -p webview",
    "test:integration": "vp run build && vscode-test",
    "capture": "vp run build && node test/capture/capture.mts",
    "refresh-media": "node test/capture/refresh-media.mts",
    "package": "vsce package --no-dependencies --no-gitHubIssueLinking --allow-unused-files-pattern",
    "publish:marketplace": "sh -c 'vsce publish --packagePath *.vsix --azure-credential --skip-duplicate'",
    "publish:open-vsx": "sh -c 'ovsx publish --packagePath *.vsix --trusted-publishing --skip-duplicate'"
  },
  "devDependencies": {
    "@effect/vitest": "^4.0.1",
    "@hero-synergy/core": "workspace:*",
    "@types/markdown-it": "^14.2.0",
    "@types/mocha": "^10.0.10",
    "@types/vscode": "~1.105.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vscode/codicons": "0.0.46-24",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "@vue/test-utils": "^2.5.1",
    "effect": "^4.0.1",
    "happy-dom": "^20.14.5",
    "markdown-it": "^15.0.2",
    "ovsx": "^1.2.0",
    "playwright": "^1.63.0",
    "typescript": "^6.0.3",
    "vue": "^3.5.0",
    "vue-tsc": "^3.3.0"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "heroSynergy",
          "title": "Hero Synergy",
          "icon": "media/hero-synergy.svg"
        }
      ]
    },
    "views": {
      "heroSynergy": [
        {
          "type": "webview",
          "id": "heroSynergy.tree",
          "name": "Maps"
        }
      ]
    },
    "commands": [
      {
        "command": "heroSynergy.openDetail",
        "title": "Open Cockpit Detail",
        "category": "Hero Synergy"
      },
      {
        "command": "heroSynergy.chartMap",
        "title": "Chart a map",
        "category": "Hero Synergy",
        "icon": "$(compass)"
      },
      {
        "command": "heroSynergy.runSkill",
        "title": "Run skill…",
        "category": "Hero Synergy",
        "icon": "$(terminal)"
      },
      {
        "command": "heroSynergy.refresh",
        "title": "Refresh",
        "category": "Hero Synergy",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "heroSynergy.chartMap",
          "when": "view == heroSynergy.tree",
          "group": "navigation@1"
        },
        {
          "command": "heroSynergy.runSkill",
          "when": "view == heroSynergy.tree",
          "group": "navigation@2"
        },
        {
          "command": "heroSynergy.refresh",
          "when": "view == heroSynergy.tree",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "Hero Synergy",
      "properties": {
        "heroSynergy.sessions.terminalLocation": {
          "type": "string",
          "enum": [
            "panel",
            "editor"
          ],
          "enumDescriptions": [
            "Open ticket sessions in the terminal panel.",
            "Open ticket sessions in editor tabs."
          ],
          "default": "panel",
          "markdownDescription": "Where the Cockpit opens a ticket session's terminal."
        },
        "heroSynergy.claude.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Location of the `claude` executable. Leave empty to resolve `claude` on `PATH`. Only your user settings are read, so a repository cannot point the Cockpit at a program of its own."
        }
      }
    }
  },
  "activationEvents": [
    "onView:heroSynergy.tree",
    "onWebviewPanel:heroSynergy.detail",
    "workspaceContains:docs/agents/issue-tracker.md"
  ],
  "extensionKind": [
    "workspace"
  ],
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0F0B30",
    "theme": "dark"
  },
  "preview": true,
  "engines": {
    "vscode": "^1.105.0"
  }
}
