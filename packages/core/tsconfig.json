{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    // No `isolatedDeclarations`: Effect services and errors are classes extending a call
    // (`Context.Service<...>()(...)`, `Data.TaggedError(...)`), which it forbids (TS9021).
    "declaration": true
  },
  "include": ["src", "fixtures/**/*.ts", "vite.config.ts"]
}
